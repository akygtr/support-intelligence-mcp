# Set to true to run with canned fixtures and no credentials
MOCK=true

# Atlassian (used by both Jira and Confluence)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SUPPORT_CHANNEL=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Gmail uses gmail_credentials.json from a Google Cloud OAuth desktop client,
# not env vars. That file is gitignored.

# LLM provider for the diagnosis and judge layer
GEMINI_API_KEY=

# Anthropic (preferred). Falls back to Gemini if unset.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
