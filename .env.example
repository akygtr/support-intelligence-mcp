# Set to true to run with canned fixtures and no credentials
MOCK=true

# Atlassian (used by both Jira and Confluence)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SUPPORT_CHANNEL=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Gmail uses gmail_credentials.json from a Google Cloud OAuth desktop client,
# not env vars. That file is gitignored.
